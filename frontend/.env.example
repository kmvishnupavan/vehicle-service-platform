# ==============================================================================
# Environment Configuration Template
# Vehicle Service Platform - React / Vite Frontend
# ==============================================================================

# Backend FastAPI URL (with /api/v1 prefix)
# Local: http://localhost:8000/api/v1
# Render: https://your-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Public Configuration (Browser-safe anon/publishable credentials)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Web Push VAPID Public Key (Optional - for browser push notifications)
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key
