# ==============================================================================
# Environment Configuration Template
# Vehicle Service Platform - FastAPI Backend
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Vehicle Service Platform API"
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list or JSON array of allowed origins. Wildcards (*) are forbidden in production/staging.
# For Render deployment, specify your Render frontend static site domain:
# e.g. CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Supabase Credentials (Required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_min_32_chars

# Payment Gateway (Razorpay Sandbox/Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Production Safety Guard (Real-money movement gate)
# MUST be false for college/demo/portfolio deployments
LIVE_PAYOUTS_ENABLED=false
PAYOUT_PROVIDER_MODE=sandbox

# Routing & Navigation (Resilient OSRM with automatic Haversine fallback)
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
OSRM_BASE_URL=http://router.project-osrm.org

# Web Push / VAPID Keys (Optional)
VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_CLAIM_EMAIL=admin@vehiclecare.app

# Operational Alert Webhook (Optional)
ALERT_WEBHOOK_URL=

# Controlled Pilot Emergency Kill Switches (Operational Circuit Breakers)
KILL_SWITCH_MATCHING_DISABLED=false
KILL_SWITCH_NEW_BOOKINGS_DISABLED=false
KILL_SWITCH_SCHEDULED_DISPATCH_DISABLED=false
KILL_SWITCH_NOTIFICATIONS_DISABLED=false
KILL_SWITCH_FORCE_ROUTING_FALLBACK=false
