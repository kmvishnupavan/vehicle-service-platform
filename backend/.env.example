# ==============================================================================
# Environment Configuration Template
# Vehicle Service Platform - FastAPI Backend
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Vehicle Service Platform API"
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list or JSON array of allowed origins. Wildcards (*) are forbidden in production.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Supabase Credentials (Required)
# Target project: vehicle-service-platform (ref: dfigtryvvujhwuiyzdvs)
SUPABASE_URL=https://dfigtryvvujhwuiyzdvs.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_OZdsss6XPdfV3SLTqlKncw_BKqgJAMn
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Routing & Navigation (Phase 15 Production Hardened)
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
# Production: Set to dedicated or self-hosted OSRM container endpoint (e.g. http://osrm-backend:5000)
OSRM_BASE_URL=http://router.project-osrm.org

# Web Push / VAPID Keys
VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here
VAPID_CLAIM_EMAIL=admin@vehiclecare.app

# Operational Alert Webhooks (Slack/PagerDuty)
ALERT_WEBHOOK_URL=

# Controlled Pilot Emergency Kill Switches
KILL_SWITCH_MATCHING_DISABLED=false
KILL_SWITCH_NEW_BOOKINGS_DISABLED=false
KILL_SWITCH_SCHEDULED_DISPATCH_DISABLED=false
KILL_SWITCH_NOTIFICATIONS_DISABLED=false
KILL_SWITCH_FORCE_ROUTING_FALLBACK=false
